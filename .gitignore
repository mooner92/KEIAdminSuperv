# ───────────────────────────────────────────────────────────
# KEI 행정 가이드 / 행정 LLM — .gitignore
# 원칙: 공개 레포 = 코드·설계문서(포트폴리오). 데이터(규정 볼트·HWP)는 비공개.
#       내부 전용 콘텐츠 + 생성물·캐시·비밀·대용량 바이너리를 제외한다.
#       볼트는 git이 아니라 Syncthing(내부 전용)으로 동기화한다. (SECURITY.md 참조)
# 주의: .gitignore 는 줄 끝 인라인 주석을 지원하지 않는다(주석은 항상 줄 단독으로).
# ───────────────────────────────────────────────────────────

# ── 내부 전용 콘텐츠 — 공개 레포에 절대 포함 금지 (KEI 내부 규정 데이터) ──
# 볼트(변환된 규정 원문)·원본 HWP. 히스토리에서도 제거(filter-repo). Syncthing으로만 동기화.
KEI-행정가이드/
rule_files/
*.hwp
*.hwpx

# ── Python (tools/) ──
tools/.venv/
tools/.venv
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ── 벡터DB / 임베딩 캐시 (재생성 가능) ──
tools/chroma/
chroma/
*.sqlite3
# ── 조문 정제 인덱스(Track A) — 규정 원문 파생물(정의문·규정명·삭제일 등). 재생성 가능, 커밋 금지 ──
tools/index/
.cache/

# ── LLM 앱 DB / 비밀키 (사용자·채팅 데이터 + 규정 스니펫 포함 → 커밋 금지) ──
tools/app.db
tools/app.db-wal
tools/app.db-shm
# ⚠ 백업본까지 — 원본만 막고 사본이 새는 구멍(보안 스캔 F4와 같은 계열):
#   app.db.pre-prod-*(승격 백업)에는 bcrypt 해시·전 사용자 채팅이 그대로 들어 있다.
tools/app.db.*
tools/app.db-*
# Claude Code 세션 설정(로컬 전용)
.claude/
tools/.app_secret

# ── 레거시 v1.0.0 동결 사본 (런타임 산출물: out/docdata 규정 원문·chroma·app.db·세션키 → 커밋 금지) ──
# 동결/실행 방법은 deploy/ecosystem.legacy-v1.config.js · deploy/README.md 참조(설정 파일만 추적).
.legacy-v1/

# ── 평가셋/리포트 (규정 원문에서 도출한 정답·금액·한도 포함 → 공개 레포 커밋 금지) ──
# 하베스트 코드(run_eval.py·run.sh)와 스키마 예시(golden.example.jsonl)만 추적한다.
eval/golden.jsonl
# PMS 정답셋 — 내부 화면ID·메뉴 경로 포함(golden.jsonl과 동급 민감도)
eval/pms_golden.jsonl
eval/reports/
eval/*.local.jsonl

# ── 검수 큐 출력 (내부 규정 목록·경로 열거 → 커밋 금지. 생성 코드 review_queue.py만 추적) ──
tools/.review_queue.json
# 인앱 피드백 신호(규정명·사유 텍스트 포함 → 커밋 금지. 생성 코드 feedback_export.py만 추적)
tools/.feedback_signals.json
tools/chroma.bak.*
tools/chroma.test/

# ── 원본 규정/가이드 소스 (내부 전용 — 절대 커밋 금지) ──
rule_files/
research_rule_files/
# 대외업무 원자료(담당자 실명 포함 내부 데이터 — 커밋 금지, docs/39)
external_affairs_raw/
*.hwp
*.hwpx
*.pptx
*.ppt
*.doc
*.docx
# ERP 기능 분석 원본(내부 시스템 구조 — 커밋 금지. 구조화 결과는 볼트(역시 gitignore)로)
KEI_ERP_entire_features.md
KEI_ERP*.md
KEI_admin_terms.md
KEI_*_terms.md
# 로컬에 내려받은 임베딩/모델 가중치
models/

# ── HWP 변환 중간 산출물 ──
# LibreOffice → PDF 중간물
tools/pdf/
*.pdf
# 변환 전 원본 HWP 보관 폴더 — 내부 문서, 비공개
원본HWP/

# ── Syncthing 런타임(디바이스 키·상태 — 비밀) ──
deploy/syncthing-config/

# ── Quartz 정적 사이트 (폐기됨) — 루트 산출물만. ⚠ 과거 비앵커 `public/`이 web/public/까지
#    블랭킷 ignore해 favicon.svg가 미추적이었다(docs/36 §6① 수술) ──
/public/
node_modules/
.quartz-cache/

# ── 브랜드 미디어(docs/36 §5) — 실규정 내용이 찍히는 영상·스크린샷은 공개 레포 금지(⛔ git add -f 금지).
#    SVG(로고 등 코드 자산)만 예외. 녹화 중간 산출물은 tools/.demo/ 로만 ──
web/public/brand/*
!web/public/brand/*.svg
tools/.demo/
*.webm
# ── 별지 원문 PDF·렌더 PNG(docs/50) — 내부 규정 콘텐츠, 공개 레포 금지(⛔ git add -f 금지) ──
web/public/forms-pdf/
tools/byeolji_png/
tools/.byeolji_cache/

# ── Next.js 웹앱 (web/) — 빌드 산출물·의존성 ──
web/.next/
web/out/
web/next-env.d.ts
.next/
out/

# ── 비밀/환경 ──
.env
*.env
*.local
secrets/
*.key
*.pem

# ── Obsidian 작업공간(공유 불필요) ──
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/

# ── OS / 에디터 ──
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Playwright 검증 스크린샷(산출물 — 스크립트만 커밋)
web/verify*.png
verify*.png
web/yeobi-*.png

# CoP/사내 발표자료 — 규정 예시 값 포함, 공개 레포 커밋 금지
발표*.md
*발표자료*
debug*.png
# 코퍼스 관리 P2 스냅샷(내부 규정 파생 벡터 — 커밋 금지)
tools/chroma.bak-*/
tools/chroma.bak/
# 파이프라인 실행 로그(규정명·별지 라벨 포함 — 내부 콘텐츠, 커밋 금지)
tools/byeolji-run*.log
tools/embed-run*.log
# 제보 분석 산출물(제보 본문 포함 — 내부 데이터, 커밋 금지)
tools/index/feedback_plans/
tools/chroma.pre-rollback-*/
chroma.bak-*/
chroma.pre-rollback-*/
tsconfig.tsbuildinfo
# 작업 부산물(잘못된 cwd 산출물·내부 보고 HTML) — 공개 레포 유입 차단
tools/tools/
web/.report-*.html

# 랜딩/디자인 스크린샷(산출물 — 커밋 금지)
web/shot-*.png
shot-*.png

# 마이그레이션 매뉴얼(내부 경로·호스트·복구절차 — 민감, 새 서버엔 별도 scp)
manual/

# PMS 연구관리시스템 원본 자료(내부 전용 — 도움말 PDF·화면캡처 판독본)
pms_raw/

# PMS 연구관리양식 원본(내부 전용 — 서식 찾기 제공 소스)
pms_forms_raw/
tools/ecosystem.local.js
