# .cbmignore — codebase-memory-mcp 색인 제외 (2차 방어)
#
# ⛔ 아래 경로는 .gitignore가 이미 전부 막고 있다(2026-07-30 확인). 그런데도 여기 다시 적는
#    이유는, 색인 도구가 .gitignore를 어떻게 해석하든 **내부 콘텐츠가 코드 인덱스에 들어가는
#    경로를 남기지 않기** 위해서다. 공개 레포 = 코드만이라는 원칙(히스토리 purge까지 했던)이
#    코드 인덱스 산출물에도 그대로 적용된다.
# ⚠ 팀 공유 아티팩트(.codebase-memory/graph.db.zst)는 만들지 않는다 — 우리 코드 인덱스가
#    담긴 커밋 가능한 파일이 생긴다. .gitignore에 선제 등록해 뒀다.

# ── 내부 콘텐츠: 규정 볼트와 원본 문서 ─────────────────────────────
KEI-행정가이드/
rule_files/
research_rule_files/
pms_raw/

# ── 운영 데이터·자격증명 ───────────────────────────────────────────
tools/chroma/
tools/chroma.bak.*
tools/app.db
tools/app.db-wal
tools/app.db-shm
tools/.app_secret
tools/.test_credentials
tools/ecosystem.local.js
web/public/forms-pdf/
web/public/quality/

# ── 색인 가치가 없는 대용량(그래프를 흐리게 만든다) ────────────────
tools/.venv/
web/node_modules/
web/out/
web/.next/
eval/daily/
docs/img/
